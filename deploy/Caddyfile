{
	admin off
}

{$RILL3_SITE_ADDRESS::80} {
	encode zstd gzip
	@youtube_websub path /webhooks/youtube */webhooks/youtube
	# The WebSub verification token is a query parameter; never write it to access logs.
	log_skip @youtube_websub

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; frame-src https://player.twitch.tv https://www.youtube.com https://www.youtube-nocookie.com; img-src 'self' data: https:; media-src 'none'; connect-src 'self'; script-src 'self'; style-src 'self'"
	}

	reverse_proxy server:3000 {
		health_uri /health/live
		health_interval 30s
		health_timeout 3s
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}

	log {
		output stdout
		format json
	}
}
