  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                creator_id,\n                provider,\n                provider_channel_id,\n                handle,\n                canonical_url,\n                current_live_url,\n                manual_live_status,\n                manual_state_expires_at,\n                embed_capability,\n                verification_state,\n                enabled,\n                created_at,\n                updated_at\n            FROM external_channels\n            WHERE provider = $1\n              AND enabled\n              AND ($2::uuid IS NULL OR id > $2)\n            ORDER BY id\n            LIMIT $3\n            ",
