# Runtime
RILL3_ENVIRONMENT=development
RILL3_BIND_ADDR=0.0.0.0:3000
RILL3_PUBLIC_ORIGIN=http://localhost:8080
# Optional mount path without a trailing slash, e.g. /rill3 behind a shared proxy.
RILL3_BASE_PATH=
RILL3_TWITCH_PARENT=localhost
RILL3_DB_MAX_CONNECTIONS=20
RUST_LOG=info,rill3=debug,tower_http=info

# Local PostgreSQL. Replace the placeholder password before any shared deployment.
POSTGRES_DB=rill3
POSTGRES_USER=rill3
POSTGRES_PASSWORD=change-me-before-shared-use
POSTGRES_PORT=5432
DATABASE_URL=postgres://rill3:change-me-before-shared-use@localhost:5432/rill3

# Provider credentials are optional in M0/M1. Empty values keep providers disabled.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
YOUTUBE_WEBSUB_TOKEN=
YOUTUBE_WEBSUB_SECRET=

# Docker Compose / Caddy development defaults
RILL3_IMAGE_TAG=dev
RILL3_HTTP_PORT=8080
RILL3_HTTPS_PORT=8443
RILL3_SITE_ADDRESS=:80

# Broadcaster identity: configure the official OAuth callback URL for each provider.
# Twitch/CHZZK reuse their client credentials above; YouTube uses a Google OAuth client.
# Callbacks: <public-origin><base-path>/auth/{twitch,youtube,chzzk}/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Native ETH donations; leave ALL chain settings unset until the factory is deployed.
# Set these together after following docs/WEB3.md. Never commit an attestor key.
# RILL3_CHAIN_ID=84532
# RILL3_CHAIN_NAME=Base Sepolia (test ETH)
# RILL3_RPC_URL=https://sepolia.base.org
# RILL3_VAULT_FACTORY=0x<deployed factory address>
# RILL3_FACTORY_CODE_HASH=0x<keccak256 of deployed runtime bytecode>
# RILL3_ATTESTOR_PRIVATE_KEY=<dedicated attestation key, not a payout wallet key>
